name: CD - Despliegue Continuo

on:
  push:
    branches: [ "main" ]

jobs:
  construir-imagen:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout del código
        uses: actions/checkout@v4

      - name: Construir imagen Docker de prueba
        run: docker build -t motor-notificaciones:latest .
